# LoanAssist v3 — environment configuration
# Copy this to .env (never commit .env with real keys)

# ── API security ────────────────────────────────────────────────────────────
API_KEY=local-dev-key

# ── LLM routing ─────────────────────────────────────────────────────────────
# LiteLLM proxy URL & Master Key (used for browser UI at http://localhost:4000/ui and API auth)
LLM_BASE_URL=http://litellm:4000/v1
LITELLM_MASTER_KEY=sk-master-key-loanassist

# Model alias as configured in litellm/config.yaml
# Options: qwen-local (offline), openrouter-mini (cloud)
LLM_MODEL=qwen-local

# ── Prompt registry ──────────────────────────────────────────────────────────
# Which version of each prompt to use. v1=stable, v2=canary.
PROMPT_VERSION=v1

# ── Policy version control ───────────────────────────────────────────────────
# Active policy version per product. Change these to activate a new policy
# without redeploying code. The RAG retrieval filters on this version.
ACTIVE_PERSONAL_LOAN_VERSION=v2
ACTIVE_HOME_LOAN_VERSION=v1
ACTIVE_AUTO_LOAN_VERSION=v1

# ── RAG / Chroma ─────────────────────────────────────────────────────────────
# Path to the ChromaDB persistent store (Docker volume mount)
CHROMA_DIR=/app/rag/chroma

# ── Audit logging ────────────────────────────────────────────────────────────
AUDIT_PATH=/app/logs/audit.jsonl

# ── Cloud provider keys ──────────────────────────────────────────────────────
# OpenRouter (cloud fallback for LiteLLM)
OPENROUTER_API_KEY=

# OpenAI (alternative)
# OPENAI_API_KEY=sk-...

# Azure OpenAI
# AZURE_API_KEY=...
# AZURE_API_BASE=https://<your-resource>.openai.azure.com/

# AWS Bedrock
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION_NAME=us-east-1

# GCP Vertex AI
# VERTEXAI_PROJECT=your-project-id
# VERTEXAI_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Observability (optional) ─────────────────────────────────────────────────
# Langfuse tracing — leave blank to disable (app degrades gracefully)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
